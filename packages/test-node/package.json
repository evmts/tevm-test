{
	"name": "@tevm/test-node",
	"version": "1.0.0-rc.151",
	"description": "Snapshot-aware TEVM test node and JSON-RPC transport.",
	"keywords": [
		"tevm",
		"ethereum",
		"evm",
		"testing",
		"vitest",
		"json-rpc",
		"snapshot"
	],
	"homepage": "https://test.tevm.sh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-test.git",
		"directory": "packages/test-node"
	},
	"bugs": {
		"url": "https://github.com/evmts/tevm-test/issues"
	},
	"license": "MIT",
	"contributors": [
		"Will Cory <willcory10@gmail.com>",
		"0xpolarzero <0xpolarzero@gmail.com>"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/**/*.spec.ts",
		"!src/**/*.snap.json",
		"!src/test/**"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm run clean && pnpm run build:dist && pnpm run build:types",
		"build:dist": "tsup",
		"build:types": "tsup --dts-only",
		"clean": "rm -rf dist types",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tevm/actions": "^1.0.0-rc.151",
		"@tevm/memory-client": "^1.0.0-rc.151",
		"@tevm/node": "^1.0.0-rc.151",
		"viem": "^2.49.3",
		"vitest": "^4.1.6"
	},
	"devDependencies": {
		"@tevm/common": "^1.0.0-rc.151",
		"@tevm/tsconfig": "^1.0.0-rc.151",
		"@tevm/tsupconfig": "^1.0.0-rc.151",
		"@tevm/utils": "^1.0.0-rc.151",
		"tevm": "^1.0.0-rc.151"
	},
	"peerDependencies": {
		"tevm": "^1.0.0-rc.151",
		"viem": "^2.49.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
