{
	"name": "@tevm/test-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Standalone TEVM test libraries and integration tests.",
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"changeset": "changeset",
		"clean": "pnpm -r --if-present run clean",
		"format": "biome format . --write",
		"format:check": "biome format .",
		"lint": "biome check .",
		"release": "pnpm build && changeset publish",
		"release:version": "changeset version && pnpm install --lockfile-only",
		"test": "pnpm -r --if-present run test",
		"typecheck": "pnpm -r --if-present run typecheck",
		"docs:dev": "pnpm --filter @tevm/test-docs dev",
		"docs:build": "pnpm --filter @tevm/test-docs build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@tevm/tsconfig": "^1.0.0-rc.151",
		"@types/node": "^25.0.0",
		"bun-types": "^1.3.14",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"viem": "^2.49.3",
		"vitest": "^4.1.6"
	}
}
